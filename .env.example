# 萤石 C6C ONVIF Adapter 配置

# 萤石开放平台凭据 (注册地址: https://open.ys7.com)
YS7_APP_KEY=your_app_key
YS7_APP_SECRET=your_app_secret

# 摄像机 IP 地址（用于 RTSP 直连）
CAMERA_IP=192.168.1.100

# RTSP 凭据（在萤石 App 中开启 RTSP 后获取）
RTSP_USER=admin
RTSP_PASS=ABCDEF

# ONVIF 服务配置
HOST_IP=192.168.1.138
ONVIF_PORT=8089
MJPEG_PORT=8555
